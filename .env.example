# BallotLens — Environment Variables

# ─── Supabase (pre-populated, do not change) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY and SUPABASE_DB_URL are auto-configured server-side

# ─── Stripe (server-side only — add as edge function secrets) ───
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SITE_URL=https://ballotlens.com

# ─── Stripe Price IDs (server-side only, edge function secrets) ───
# Confirmed pricing (Sept 2026): Candidate $9/mo or $89/yr, Pro $29/mo or $289/yr,
# Candidate Management $299 (per claimed candidate profile — claiming itself is FREE).
# STRIPE_CANDIDATE_MONTHLY_PRICE_ID=price_...
# STRIPE_CANDIDATE_YEARLY_PRICE_ID=price_...
# STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# STRIPE_PRO_YEARLY_PRICE_ID=price_...
# STRIPE_CANDIDATE_MANAGEMENT_PRICE_ID=price_...

# ─── AP Elections API (server-side only) ───
# AP_ELECTIONS_API_KEY=your_ap_api_key

# ─── Resend — transactional email (server-side only, edge function secret) ───
# Powers: instant email alerts, the weekly/daily BallotLens Digest, election
# reminders, team invite notifications, and message notifications.
# Get a key at https://resend.com — needs a verified sending domain
# (e.g. ballotlens.com) before it can email anyone besides your own
# Resend account email.
# RESEND_API_KEY=re_...

# ─── Future API integrations (not yet connected) ───
# VITE_GOOGLE_CIVIC_API_KEY=
# VITE_AI_API_KEY=

# ─── Email unsubscribe links (server-side only, edge function secret) ───
# Signs the one-click unsubscribe links in digest/reminder emails. Optional:
# falls back to the service role key if unset. Changing it invalidates links
# in emails that were already sent.
# EMAIL_UNSUBSCRIBE_SECRET=<long random string>
